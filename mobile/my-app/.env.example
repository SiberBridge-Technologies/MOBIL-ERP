# ==========================================================
# ERP-APP Mobil — Ortam Değişkenleri Şablonu
# ==========================================================
# 1. Bu dosyayı ".env" olarak kopyalayın (mobile/ klasörünün köküne).
# 2. Kendi backend adresinizi yazın.
# 3. app.json'DA DEĞİL, sadece burada değişiklik yapın.
# 4. Değiştirdikten sonra Expo'yu MUTLAKA "npx expo start -c" ile
#    (önbellek temizleyerek) yeniden başlatın, yoksa eski değer kullanılır.
#
# EXPO_PUBLIC_ önekiyle başlayan değişkenler Expo tarafından otomatik
# olarak process.env üzerinden koda dahil edilir (ekstra paket gerekmez).
# ==========================================================

# XAMPP ile yerel ağda test ederken (kendi bilgisayarınızın IP'si):
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.34/erp/api

# Gerçek bir hosting'e taşındığında örnek:
# EXPO_PUBLIC_API_BASE_URL=https://sizin-domaininiz.com/api
