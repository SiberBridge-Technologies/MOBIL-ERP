# ==========================================================
# ERP-APP Backend — Ortam Değişkenleri Şablonu
# ==========================================================
# 1. Bu dosyayı ".env" olarak kopyalayın (aynı config/ klasörüne).
# 2. Aşağıdaki değerleri KENDİ ortamınıza göre doldurun.
# 3. Gerçek ".env" dosyasını ASLA git'e veya paylaşılan bir yere
#    yüklemeyin — sadece sunucunuzda kalmalı. Bu dosya (.env.example)
#    şifre İÇERMEZ, sadece hangi alanların doldurulması gerektiğini gösterir.
#
# Not: .env dosyası config/ klasörünün içinde tutulur çünkü o klasöre
# doğrudan tarayıcı erişimi zaten .htaccess ile engellenmiştir.
# ==========================================================

# ---------- Veritabanı ----------
# XAMPP (yerel) için:      DB_HOST=localhost, DB_USER=root, DB_PASS= (boş)
# cPanel / InfinityFree için: hosting panelinizin verdiği tam bilgileri kullanın
DB_HOST=localhost
DB_NAME=erp
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ---------- Uygulama ----------
# true  = hata ayıklama modu (ekranda PHP hatalarını gösterir) — SADECE yerel/test ortamında
# false = canlı/gerçek hosting ortamında MUTLAKA false olmalı
APP_DEBUG=false
APP_TIMEZONE=Europe/Istanbul

# ---------- Kimlik doğrulama ----------
# Oturum token'ının geçerlilik süresi (saniye). 28800 = 8 saat
TOKEN_LIFETIME=28800

# ---------- CORS ----------
# Mobil uygulamanın API'ye erişebilmesi için. Genelde "*" yeterlidir.
ALLOWED_ORIGIN=*
